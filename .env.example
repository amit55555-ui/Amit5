# ===== אחסון נתונים =====
# מוגדר אוטומטית ע"י אינטגרציית Neon/Postgres ב-Vercel.
# בלי ערך — האפליקציה עובדת מקומית עם אחסון בזיכרון (נמחק בכל הפעלה מחדש).
DATABASE_URL=

# ===== אחסון תמונות (Vercel Blob) =====
# מוגדר אוטומטית ע"י אינטגרציית Vercel Blob.
# בלי ערך — תמונות נשמרות כ-data URL ישירות במסד הנתונים (עובד, פחות יעיל).
BLOB_READ_WRITE_TOKEN=

# ===== ממשק ניהול (/admin) =====
# סיסמת המנהל. בלי ערך – ממשק הניהול כבוי. שינוי הסיסמה מנתק את כל המחוברים.
LEAKMAP_ADMIN_PASSWORD=
