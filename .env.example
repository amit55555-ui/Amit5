# ===== חיבור Google Calendar (אופציונלי) =====
# בלי הערכים האלה האפליקציה עובדת במצב דמו (localStorage).
# עם הערכים – כל תור נכנס ליומן Google של הספר, הלקוח מקבל
# מייל אישור/ביטול אוטומטי, והזמינות נקבעת לפי היומן.
#
# איך משיגים את הערכים – ראו SETUP.md

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# היומן שאליו נכתבים התורים. 'primary' = היומן הראשי של החשבון.
GOOGLE_CALENDAR_ID=primary

# אזור הזמן של המספרה (IANA)
BARBER_TIMEZONE=Asia/Jerusalem
