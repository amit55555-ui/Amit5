# ===== הגדרות הבניין (גלויות בצד הלקוח) =====
# שם הבניין שמוצג בראש האפליקציה
NEXT_PUBLIC_BUILDING_NAME=רחוב צה״ל
# רשימת הכניסות (מספרי הבניין) המחוברים יחדיו, מופרדים בפסיקים
NEXT_PUBLIC_ENTRANCES=77,79,81,83,85
# קוד גישת ועד לתצוגת הדמו (כש-COMMITTEE_PASSCODE לא מוגדר בשרת)
NEXT_PUBLIC_DEMO_PASSCODE=1234

# ===== גישת ועד הבית (צד שרת) =====
# קוד הגישה לדשבורד הוועד. הגדירו קוד משלכם בפרודקשן.
COMMITTEE_PASSCODE=1234

# ===== שליחת מיילים דרך Gmail (אופציונלי) =====
# בלי הערכים האלה האפליקציה עובדת — פשוט לא נשלחים מיילים.
# עם הערכים: כל פנייה חדשה נשלחת לוועד במייל, ותגובות/שינויי סטטוס
# נשלחים לדייר. ראו SETUP.md להוראות.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# כתובת המייל של ועד הבית (לקבלת הדיווחים)
COMMITTEE_EMAIL=

# ===== אחסון נתונים (אופציונלי) =====
# ספריית הכתיבה לקובץ הנתונים. ברירת מחדל: ספריית temp של המערכת.
# DATA_DIR=/data
